{
  "name": "git-next",
  "displayName": "Git Next",
  "description": "Git 그래프와 기본 Pull/Push를 한눈에 보여주는 개인용 VS Code 확장입니다.",
  "version": "0.2.0",
  "publisher": "doh-local",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "SCM Providers",
    "Education"
  ],
  "activationEvents": [
    "onCommand:gitNext.open",
    "onCommand:gitNext.fileHistory",
    "onView:gitNext.sidebar"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitNext.open",
        "title": "Git Next: 그래프 열기"
      },
      {
        "command": "gitNext.fileHistory",
        "title": "Git Next: 파일 커밋 이력 그래프에서 보기"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "gitNext.fileHistory",
          "when": "resourceScheme == file",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitNext",
          "title": "Git Next",
          "icon": "assets/git-next.svg"
        }
      ]
    },
    "views": {
      "gitNext": [
        {
          "type": "webview",
          "id": "gitNext.sidebar",
          "name": "Git Next"
        }
      ]
    },
    "configuration": {
      "title": "Git Next",
      "properties": {
        "gitNext.pullBeforePush": {
          "type": "boolean",
          "default": false,
          "description": "Push 전에 안전한 Pull을 먼저 실행합니다. 안전하게 업데이트할 수 없으면 Push를 중단합니다."
        },
        "gitNext.ai.provider": {
          "type": "string",
          "enum": ["off", "codex", "ollama"],
          "default": "off",
          "description": "Git 상황 진단에 사용할 AI Provider입니다."
        },
        "gitNext.ai.ollamaEndpoint": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Ollama 로컬 API 주소입니다."
        },
        "gitNext.ai.ollamaModel": {
          "type": "string",
          "default": "",
          "description": "AI 진단에 사용할 Ollama 모델 이름입니다."
        },
        "gitNext.protectedBranches": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["main", "master", "release/*"],
          "description": "위험한 이력 변경 작업에서 추가 경고를 표시할 보호 브랜치 패턴입니다."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "package": "npx --yes @vscode/vsce package --allow-missing-repository --out git-next-0.2.0.vsix",
    "setup": "npm test && npm run build && npm run package"
  }
}
